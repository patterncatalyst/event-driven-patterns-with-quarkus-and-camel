   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Each consumersCount thread is a separate group member. Members beyond the partition count own nothing. The default RangeAssignor leaves nine idle.",
   "fontSize": 12,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Each consumersCount thread is a separate group member. Members beyond the partition count own nothing. The default RangeAssignor leaves nine idle.",
   "lineHeight": 1.25,
   "baseline": 12
  }
