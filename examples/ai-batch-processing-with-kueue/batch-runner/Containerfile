# Build context is examples/ so the shared domain model can be installed first.
#   docker build -f ai-batch-processing-with-kueue/batch-runner/Containerfile -t ai-batch-runner examples
FROM registry.access.redhat.com/ubi10/openjdk-25:1.24-20 AS build
USER 185
WORKDIR /build
COPY --chown=185:0 domain-model/ domain-model/
COPY --chown=185:0 ai-batch-processing-with-kueue/pom.xml ai-batch-processing-with-kueue/pom.xml
COPY --chown=185:0 ai-batch-processing-with-kueue/batch-runner/pom.xml ai-batch-processing-with-kueue/batch-runner/pom.xml
COPY --chown=185:0 ai-batch-processing-with-kueue/batch-runner/src ai-batch-processing-with-kueue/batch-runner/src
RUN mvn -B -ntp -q -f domain-model/pom.xml install -DskipTests \
 && mvn -B -ntp -q -f ai-batch-processing-with-kueue/batch-runner/pom.xml package -DskipTests

FROM registry.access.redhat.com/ubi10/openjdk-25-runtime:1.24-20
ENV JAVA_APP_JAR=/deployments/quarkus-run.jar \
    JAVA_OPTS_APPEND="-Dquarkus.http.host=0.0.0.0 -Djava.util.logging.manager=org.jboss.logmanager.LogManager"
COPY --from=build --chown=185 /build/ai-batch-processing-with-kueue/batch-runner/target/quarkus-app/lib/ /deployments/lib/
COPY --from=build --chown=185 /build/ai-batch-processing-with-kueue/batch-runner/target/quarkus-app/*.jar /deployments/
COPY --from=build --chown=185 /build/ai-batch-processing-with-kueue/batch-runner/target/quarkus-app/app/ /deployments/app/
COPY --from=build --chown=185 /build/ai-batch-processing-with-kueue/batch-runner/target/quarkus-app/quarkus/ /deployments/quarkus/
EXPOSE 8080
USER 185
