# Build context is this example's directory:
#   docker build -f inventory-service/Containerfile -t inventory-service .
FROM registry.access.redhat.com/ubi10/openjdk-25:1.24-20 AS build
USER 185
WORKDIR /build
COPY --chown=185:0 pom.xml pom.xml
COPY --chown=185:0 inventory-service/pom.xml inventory-service/pom.xml
COPY --chown=185:0 inventory-service/src inventory-service/src
RUN mvn -B -ntp -q -f inventory-service/pom.xml package -DskipTests

FROM registry.access.redhat.com/ubi10/openjdk-25-runtime:1.24-20
ENV JAVA_APP_JAR=/deployments/quarkus-run.jar \
    JAVA_OPTS_APPEND="-Dquarkus.http.host=0.0.0.0 -Djava.util.logging.manager=org.jboss.logmanager.LogManager"
COPY --from=build --chown=185 /build/inventory-service/target/quarkus-app/lib/ /deployments/lib/
COPY --from=build --chown=185 /build/inventory-service/target/quarkus-app/*.jar /deployments/
COPY --from=build --chown=185 /build/inventory-service/target/quarkus-app/app/ /deployments/app/
COPY --from=build --chown=185 /build/inventory-service/target/quarkus-app/quarkus/ /deployments/quarkus/
EXPOSE 8080
USER 185
