# Pins for the OpenShift Local example. Sourced by lib.sh; the Debezium plugin pin is in ../_k8s/versions.env.
# The operator versions are the ones of the Part 6 manifests (STRIMZI_VERSION, CNPG_VERSION in ../_k8s/versions.env).
NS=edp
NS_OP=edp-operators

# OLM: package, channel, catalog and the exact CSV each Subscription starts at (Manual approval).
STRIMZI_PACKAGE=strimzi-kafka-operator
STRIMZI_CHANNEL=strimzi-1.x
STRIMZI_CATALOG=community-operators
STRIMZI_CSV=strimzi-cluster-operator.v1.3.1
CNPG_PACKAGE=cloudnative-pg
CNPG_CHANNEL=stable-v1
CNPG_CATALOG=certified-operators
CNPG_CSV=cloudnative-pg.v1.30.1

# The application image: built from the chapter 08 Containerfile, copied to the imagestream edp/order-service.
APP_LOCAL_IMAGE=localhost/edp/08-order-service:crc
APP_IMAGESTREAM=order-service
APP_TAG=08
APP_CONTAINERFILE=08-transactional-outbox/order-service/Containerfile
APP_INTERNAL_REPO=image-registry.openshift-image-registry.svc:5000/edp/order-service

ORDER=O-4301
TOPIC=edp.orders.placed
