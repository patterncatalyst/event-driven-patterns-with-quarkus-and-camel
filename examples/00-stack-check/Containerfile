# Build context is examples/ so the shared domain model can be installed first.
#   docker build -f 00-stack-check/Containerfile -t stack-check examples
FROM registry.access.redhat.com/ubi10/openjdk-25:1.24-19 AS build
USER 185
WORKDIR /build
COPY --chown=185:0 domain-model/ domain-model/
COPY --chown=185:0 00-stack-check/pom.xml 00-stack-check/pom.xml
COPY --chown=185:0 00-stack-check/src 00-stack-check/src
RUN mvn -B -ntp -q -f domain-model/pom.xml install -DskipTests \
 && mvn -B -ntp -q -f 00-stack-check/pom.xml package -DskipTests

FROM registry.access.redhat.com/ubi10/openjdk-25-runtime:1.24-19
ENV JAVA_APP_JAR=/deployments/quarkus-run.jar \
    JAVA_OPTS_APPEND="-Dquarkus.http.host=0.0.0.0 -Djava.util.logging.manager=org.jboss.logmanager.LogManager"
COPY --from=build --chown=185:0 /build/00-stack-check/target/quarkus-app/ /deployments/
EXPOSE 8080
USER 185
