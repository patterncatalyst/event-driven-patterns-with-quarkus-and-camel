# Pins for the Part 6 minikube substrate. Sourced by tools.sh, cluster.sh and lib.sh.
MINIKUBE_VERSION=v1.39.0
K8S_VERSION=v1.37.2
KUBECTL_VERSION=v1.37.2
STRIMZI_VERSION=1.3.1
CNPG_VERSION=1.30.1

STRIMZI_URL=https://github.com/strimzi/strimzi-kafka-operator/releases/download/1.3.1/strimzi-cluster-operator-1.3.1.yaml
STRIMZI_SHA256=557c1452cbf58f80714858b25203cb644de5b15edb1e9adf6bf7fcf8b22a1931
STRIMZI_FILE=strimzi/strimzi-cluster-operator-1.3.1.yaml
CNPG_URL=https://github.com/cloudnative-pg/cloudnative-pg/releases/download/v1.30.1/cnpg-1.30.1.yaml
CNPG_SHA256=37237f145d8138256ea25ae830f87759255665ff08f8d552fdd8224a5ec032fb
CNPG_FILE=platform/cnpg/cnpg-1.30.1.yaml

MK_PROFILE=edp
MK_CPUS=6
MK_MEMORY=10g
MK_DISK=30g
# Published on 127.0.0.1 only: apps 30080 30082 30084, Grafana 30300, Tempo 30320, Loki 30100, Prometheus 30909.
MK_PORTS="30080 30082 30084 30100 30300 30320 30909"

# r12 additions (pinned once, latest stable; digests are the image index digests)
KSM_VERSION=v2.20.0
KSM_IMAGE=registry.k8s.io/kube-state-metrics/kube-state-metrics:v2.20.0@sha256:42cfe3723a5f058171c627537fb57a3ea0f26e4380fa18555a95cb1a1b4cfc5b
REGISTRY_VERSION=3.1.2
REGISTRY_IMAGE=docker.io/library/registry:3.1.2@sha256:82f6ff4a7f982960c8aa51617fea3aabc485df6e55cce80d22deb1de36f1bc3c
# The in-cluster registry has a fixed ClusterIP inside the service CIDR (cluster.sh makes the node pull from it over HTTP).
REGISTRY_IP=10.96.100.50
REGISTRY_PORT=5000
MK_INSECURE_REGISTRY=10.96.100.50:5000
# Buildah image the Strimzi 1.3.1 operator runs for KafkaConnect builds (STRIMZI_DEFAULT_BUILDAH_IMAGE; recorded, not chosen).
BUILDAH_IMAGE=quay.io/strimzi/buildah:1.3.1
# Debezium PostgreSQL connector plugin archive for the KafkaConnect build (Maven Central; same Debezium pin as compose).
DEBEZIUM_PLUGIN_URL=https://repo1.maven.org/maven2/io/debezium/debezium-connector-postgres/3.7.1.Final/debezium-connector-postgres-3.7.1.Final-plugin.tar.gz
DEBEZIUM_PLUGIN_SHA512=d118c8eb994153c9cb687ee9071d09d07b5a03aafc03f5d898bd8ffa86ba801342be30723736f8d2803ae4a708a33295335f54d9f1af99d8c348461579a85868

# r16 additions: Kueue (Appendix I only; installed and removed by that verify.sh, never by cluster.sh up)
KUEUE_VERSION=v0.20.6
KUEUE_MANIFEST_URL=https://github.com/kubernetes-sigs/kueue/releases/download/v0.20.6/manifests.yaml
KUEUE_MANIFEST_SHA256=b5f643595cfe4799b47acd3499f535fb7137af1dd734a5a66ed67a4fe9f9e466
